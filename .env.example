# Required: your Cala API key (https://console.cala.ai)
JUNCTION_CALA_API_KEY=

# Optional. Without it the drafts come from a template.
JUNCTION_GEMINI_API_KEY=

# Optional. Without it "says vs did" is off.
JUNCTION_OXYLABS_API_KEY=

# Optional. The token JSON of a Slush MCP connection; without it the Slush lines are off.
JUNCTION_SLUSH_MCP_TOKEN_JSON=

# Fresh Cala calls the server may make in total, and per visitor a day.
CALA_CREDIT_CAP=3060
CALA_VISITOR_CAP=150
